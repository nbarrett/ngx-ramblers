CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# --- Self-hosted Jitsi video meetings (issue #357) ---
# Resolved with the same single-value toggle as INTEGRATION_WORKER_URL.
# Unset: NGX opens the free public meet.jit.si page (no embed, no JWT).
# Set to your Jitsi host to embed the call inside NGX. Local docker stack: https://localhost:8443 (see jitsi/README.md).
JITSI_HOST_URL=
# Enforced identity for a self-hosted host: NGX signs a per-meeting JWT so members join without a
# second sign-in and committee members become moderators. Must match the Jitsi stack's
# JWT_APP_ID / JWT_APP_SECRET. Leave unset (or on a public host) and no JWT is issued.
JITSI_JWT_APP_ID=
JITSI_JWT_APP_SECRET=

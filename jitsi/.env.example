# docker-jitsi-meet configuration for NGX-Ramblers video meetings.
# Copy to jitsi/.env and fill in. Generate the internal component secrets with:
#   docker run --rm jitsi/base:stable gen-passwords.sh   (or set your own long random values)
#
# The three JWT_* values must match the NGX server environment variables
# JITSI_JWT_APP_ID / JITSI_JWT_APP_SECRET so that NGX-issued meeting tokens are trusted.

# --- Web ---
# Local dev: https://localhost:8443. Self-host: the app's public https URL (e.g. https://ngx-ramblers-jitsi.fly.dev).
PUBLIC_URL=https://localhost:8443
HTTP_PORT=8000
HTTPS_PORT=8443
TZ=Europe/London

# Config volume on the host (docker-jitsi-meet writes generated config here).
CONFIG=~/.jitsi-meet-cfg

# --- JVB (media bridge) ---
# UDP media port. Must be reachable from clients; on Fly this needs a dedicated IP + a udp service.
JVB_PORT=10000
# Public media IP(s) JVB advertises for ICE. On a plain VM set to the host's public IP;
# on Fly set to the app's dedicated public IPv4.
JVB_ADVERTISE_IPS=
DOCKER_HOST_ADDRESS=

# --- JWT authentication (NGX is the only issuer) ---
ENABLE_AUTH=1
ENABLE_GUESTS=0
# Do not make every participant a moderator. With this off, moderator is granted
# only from the JWT moderator claim (committee members), so guests join without controls.
ENABLE_AUTO_OWNER=0
AUTH_TYPE=jwt
JWT_APP_ID=ngx-ramblers
JWT_APP_SECRET=change-me-to-a-long-random-secret
JWT_ACCEPTED_ISSUERS=ngx-ramblers
JWT_ACCEPTED_AUDIENCES=ngx-ramblers

# --- XMPP domains (docker-jitsi-meet defaults; leave as-is unless you know why) ---
XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_GUEST_DOMAIN=guest.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_RECORDER_DOMAIN=recorder.meet.jitsi
XMPP_BOSH_URL_BASE=http://xmpp.meet.jitsi:5280
XMPP_SERVER=xmpp.meet.jitsi
ENABLE_XMPP_WEBSOCKET=1

# --- Internal component secrets (set to long random values) ---
JICOFO_COMPONENT_SECRET=
JICOFO_AUTH_USER=focus
JICOFO_AUTH_PASSWORD=
JVB_AUTH_USER=jvb
JVB_AUTH_PASSWORD=
JVB_BREWERY_MUC=jvbbrewery
JVB_STUN_SERVERS=meet-jit-si-turnrelay.jitsi.net:443

#!/usr/bin/with-contenv bash
set -euo pipefail

configure_fly_media() {
  if [[ -n "${FLY_APP_NAME:-}" ]]; then
    local media_address
    if ! media_address=$(getent ahostsv4 fly-global-services | awk 'NR == 1 { print $1 }') || [[ -z "$media_address" || -z "${JVB_ADVERTISE_IPS:-}" ]]; then
      echo "FATAL ERROR: Fly media requires fly-global-services and JVB_ADVERTISE_IPS" >&2
      exit 1
    elif [[ ! "$JVB_ADVERTISE_IPS" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      echo "FATAL ERROR: Fly media requires one dedicated public IPv4 address" >&2
      exit 1
    else
      cat >> /config/jvb.conf <<EOF

ice4j.harvest.allowed-addresses = [ "$media_address" ]
ice4j.harvest.mapping.stun.addresses = []
ice4j.harvest.mapping.static-mappings = [
  {
    local-address = "$media_address"
    public-address = "$JVB_ADVERTISE_IPS"
    local-port = ${JVB_PORT:-10000}
    public-port = ${JVB_PORT:-10000}
    name = "fly-media"
  }
]
EOF
      echo "Configured Fly media on $media_address:${JVB_PORT:-10000}"
    fi
  fi
}

configure_fly_media

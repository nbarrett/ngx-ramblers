#!/usr/bin/env bash

set -e

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck source=/dev/null
  . "$NVM_DIR/nvm.sh"
  cd "$ROOT_DIR"
  nvm use
fi

echo "Node.js version in hook: $(node --version)"
echo "Node.js path in hook: $(which node)"

source "${ROOT_DIR}/node_modules/@annix/claude-swarm/timer.sh"

echo "Running pre-push checks..."

run_lint() {
  cd "$ROOT_DIR"
  npm run lint:all
}

run_typecheck() {
  cd "$ROOT_DIR"
  npm run typecheck:server
}

run_frontend_tests() {
  cd "$ROOT_DIR"
  npm run test
}

run_server_tests() {
  cd "$ROOT_DIR"
  npm run test:server
}

cd "$ROOT_DIR"
timed_step "lint" run_lint
timed_step "server typecheck" run_typecheck
timed_step "frontend tests" run_frontend_tests
timed_step "server tests" run_server_tests

print_timing_summary

echo "Pre-push checks passed!"

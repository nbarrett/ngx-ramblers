#!/usr/bin/env bash

set -e

ROOT_DIR="$(git rev-parse --show-toplevel)"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|html)$' || true)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "Running lint on staged files..."
cd "$ROOT_DIR"
npm run build:eslint-config --silent
npx eslint --config .eslint-config/eslint.config.js $STAGED_FILES
STAGED_COMPONENTS=$(echo "$STAGED_FILES" | grep -E '^projects/ngx-ramblers/.*\.ts$' || true)
if [ -n "$STAGED_COMPONENTS" ]; then
  npx ts-node --project tsconfig.tools.json ./tools/check-inline-sass.ts $STAGED_COMPONENTS
fi
echo "Staged file lint passed!"
